NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model ids are chosen in a later issue (model evaluation).
NVIDIA_MODEL_CREATIVE=
NVIDIA_MODEL_CODE=
PORT=8787
